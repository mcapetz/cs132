.equiv @sbrk, 9
.equiv @print_string, 4
.equiv @print_char, 11
.equiv @print_int, 1
.equiv @exit 10
.equiv @exit2, 17
.text


	jal Main
	li a0, @exit
	ecall

.globl Main
	Main:
	sw fp, -8(sp)
	mv fp, sp
	li t6, 12
	sub sp, sp, t6
	sw ra, -4(fp)
	li s3, 4
	mv a0, s3
	jal alloc
	mv s2, a0
	beqz s2, null_err
	li s3, 4
	mv a0, s3
	jal alloc
	mv s1, a0
	beqz s1, null_err
	la s3, Arun
	sw s3, 0(s1)
	sw s1, 0(s2)
	beqz s2, null_err
	lw s3, 0(s2)
	lw s3, 0(s3)
	mv a2, s2
	li t6, 0
	sub sp, sp, t6
	jalr s3
	mv s1, a0
	mv a1, s1
	li a0, @print_int
	ecall
	li a1, 10
	li a0, @print_char
	ecall
	j main_end
null_err:
	la a0, msg_0
	j error
array_err:
	la a0, msg_0
	j error
main_end:
	li s1, 0
	sw s1, -12(fp)
	lw a0, -12(fp)
	lw ra, -4(fp)
	lw fp, -8(fp)
	addi sp, sp, 12
	addi sp, sp, 0
	jr ra

.globl Arun
	Arun:
	sw fp, -8(sp)
	mv fp, sp
	li t6, 12
	sub sp, sp, t6
	sw ra, -4(fp)
	mv t0, a2
	li t1, 20
	li t2, 0
	slt t0, t1, t2
	li t2, 1
	sub t0, t2, t0
	beqz t0, array_err
	add t0, t1, t2
	li t2, 4
	mul t0, t2, t0
	mv a0, t0
	jal alloc
	mv t2, a0
	beqz t2, null_err
	sw t1, 0(t2)
	mv t0, t2
	li t1, 10
	beqz t0, null_err
	lw t3, 0(t0)
	li t2, 1
	li t5, 0
	sub t5, t5, t2
	slt t4, t5, t1
	beqz t4, array_err
	slt t4, t1, t3
	beqz t4, array_err
	li t4, 4
	add t3, t1, t2
	mul t3, t3, t4
	add t2, t0, t3
	lw t1, 0(t2)
	mv a1, t1
	li a0, @print_int
	ecall
	li a1, 10
	li a0, @print_char
	ecall
	li t3, 40
	beqz t0, null_err
	lw t1, 0(t0)
	li t4, 1
	li t5, 0
	sub t5, t5, t4
	slt t2, t5, t3
	beqz t2, array_err
	slt t2, t3, t1
	beqz t2, array_err
	li t2, 4
	add t1, t3, t4
	mul t1, t1, t2
	add t2, t0, t1
	lw t0, 0(t2)
	j Arun_end
	la a0, msg_0
	j error
	la a0, msg_0
	j error
Arun_end:
	sw t0, -12(fp)
	lw a0, -12(fp)
	lw ra, -4(fp)
	lw fp, -8(fp)
	addi sp, sp, 12
	addi sp, sp, 0
	jr ra

.globl error
error:
	mv a1, a0
	li a0, @print_string
	ecall
	li a1, 10
	li a0, @print_char
	ecall
	li a0, @exit
	ecall
abort_17:
	j abort_17

.globl alloc
alloc:
	mv a1, a0
	li a0, @sbrk
	ecall
	jr ra
.data


.globl msg_0
msg_0:
	.asciiz "null pointer"

