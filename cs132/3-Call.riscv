.equiv @sbrk, 9
.equiv @print_string, 4
.equiv @print_char, 11
.equiv @print_int, 1
.equiv @exit 10
.equiv @exit2, 17
.text


	jal Main
	li a0, @exit
	ecall

.globl Main
	Main:
	sw fp, -8(sp)
	mv fp, sp
	li t6, 12
	sub sp, sp, t6
	sw ra, -4(fp)
	li t2, 4
	mv a0, t2
	jal alloc
	mv t3, a0
	bnez t3, short_null_err0
	j null_err
short_null_err0:
	li t2, 4
	mv a0, t2
	jal alloc
	mv t2, a0
	bnez t2, short_null_err1
	j null_err
short_null_err1:
	la t4, Arun
	sw t4, 0(t2)
	sw t2, 0(t3)
	bnez t3, short_null_err2
	j null_err
short_null_err2:
	lw t4, 0(t3)
	lw t4, 0(t4)
	mv t0, t4
	mv a2, t3
	li t6, 0
	sub sp, sp, t6
	jalr t0
	mv t0, a0
	mv t4, t0
	mv a1, t4
	li a0, @print_int
	ecall
	li a1, 10
	li a0, @print_char
	ecall
	j main_end
null_err:
	la a0, msg_0
	j error
array_err:
	la a0, msg_1
	j error
main_end:
	li t4, 0
	sw t4, -12(fp)
	lw a0, -12(fp)
	lw ra, -4(fp)
	lw fp, -8(fp)
	addi sp, sp, 12
	addi sp, sp, 0
	jr ra

.globl Arun
	Arun:
	sw fp, -8(sp)
	mv fp, sp
	li t6, 12
	sub sp, sp, t6
	sw ra, -4(fp)
	li t2, 42
	mv a1, t2
	li a0, @print_int
	ecall
	li a1, 10
	li a0, @print_char
	ecall
	li t2, 99
	j Arun_end
	la a0, msg_0
	j error
	la a0, msg_1
	j error
Arun_end:
	sw t2, -12(fp)
	lw a0, -12(fp)
	lw ra, -4(fp)
	lw fp, -8(fp)
	addi sp, sp, 12
	addi sp, sp, 0
	jr ra

.globl error
error:
	mv a1, a0
	li a0, @print_string
	ecall
	li a1, 10
	li a0, @print_char
	ecall
	li a0, @exit
	ecall
abort_17:
	j abort_17

.globl alloc
alloc:
	mv a1, a0
	li a0, @sbrk
	ecall
	jr ra
.data


.globl msg_0
msg_0:
	.asciiz "null pointer"
.globl msg_1
msg_1:
	.asciiz "array index out of bounds"

