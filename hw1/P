// Test cases for S productions
{ System.out.println(true); }
System.out.println(true);
if (true) { System.out.println(true); } else { System.out.println(true); }
while (true) { System.out.println(true); }
while (true) System.out.println(true);

// Test cases for L productions
{ System.out.println(true); System.out.println(true); }
System.out.println(true); System.out.println(true);
if (true) { System.out.println(true); } else { System.out.println(true); } System.out.println(true);
while (true) { System.out.println(true); System.out.println(true); }


