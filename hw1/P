!!true
!!false

// Test cases for mixed productions should succeed
if (!true) { System.out.println(true); } else { while (false) { System.out.println(true); } }
{ while (!false) { if (!true) { System.out.println(true); } else { System.out.println(true); } } }
System.out.println(!false);

